# ==========================================
# Synap - Neural Task Engine (Environment)
# ==========================================

# Porta local do servidor web Vite (padrão: 8090 para evitar colisão com portas 8080/8085)
PORT=8090

# Caminho opcional customizado para a chave de conta de serviço Firebase Admin
# (Se não informado, o sistema busca automaticamente por 'serviceAccountKey.json' na raiz)
# FIREBASE_SERVICE_ACCOUNT="./serviceAccountKey.json"

# Configurações públicas do Firebase Client Web (fallback caso queira sobrescrever)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN="smart-task-manager-ia.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="smart-task-manager-ia"
# VITE_FIREBASE_STORAGE_BUCKET="smart-task-manager-ia.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="418342155714"
# VITE_FIREBASE_APP_ID="1:418342155714:web:b85297a844a692a896125b"
